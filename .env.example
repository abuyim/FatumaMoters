# ==========================
# FatumaMotors server config
# ==========================

# Server
PORT=4000

# Admin login credentials (used by /api/auth/login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# MySQL (optional)
# If MYSQL_HOST is set, the app will try MySQL first.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=site_fatumamotors_db
MYSQL_CONNECTION_LIMIT=10
